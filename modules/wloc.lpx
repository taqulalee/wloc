#!name=Apple WLOC 定位修改
#!desc=修改 Apple 网络定位返回坐标 | 快捷指令(推荐): 设置地理位置 https://www.icloud.com/shortcuts/e50b5de193354a1bade3f116c16d9b42 清理恢复位置 https://www.icloud.com/shortcuts/35c2bab34b724046bdfb82bcf7b5172e
#!icon=https://raw.githubusercontent.com/taqulalee/wloc/refs/heads/codex/self-hosted-hardening/wloc.jpg
#!author=Yu9191 Rewrite
#!homepage=https://github.com/taqulalee/wloc
#!openUrl=https://wloc-taqulalee.killer-100.workers.dev/

[Argument]
longitude = input, "113.94114", tag=经度(在线选点优先)
latitude = input, "22.544577", tag=纬度(在线选点优先)
accuracy = input, "25", tag=精度(米)
logLevel = select, "info", "off", "error", "warn", "debug", "all", tag=日志级别

[Script]
http-response ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc script-path=https://raw.githubusercontent.com/taqulalee/wloc/refs/heads/codex/self-hosted-hardening/dist/wloc.js, requires-body=true, binary-body-mode=true, timeout=30, tag=Apple WLOC, argument=[{longitude},{latitude},{accuracy},{logLevel}]
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://raw.githubusercontent.com/taqulalee/wloc/refs/heads/codex/self-hosted-hardening/dist/wloc-settings.js, timeout=10, tag=WLOC Settings

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com
